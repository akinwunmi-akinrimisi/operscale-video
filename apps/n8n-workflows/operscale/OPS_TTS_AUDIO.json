    {
      "id": "write-file-ffprobe",
      "name": "Write File + FFprobe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3770,
        0
      ],
      "parameters": {
        "jsCode": "// Write audio file to disk + get duration via ffprobe\n// Replaces WriteBinaryFile (Bug 36 fix) + FFprobe Duration\nconst { execSync } = require('child_process');\n\nconst item = $input.first();\nconst sceneData = item.json;\nconst filePath = sceneData.file_path;\n\n// Get base64 audio data from binary property\nconst base64Data = item.binary?.data?.data;\nif (!base64Data) {\n  throw new Error('No binary audio data found in input');\n}\n\n// Write decoded audio to disk using child_process\n// (bypasses n8n WriteBinaryFile internal access check - Bug 36)\nexecSync(`cat > \"${filePath}\"`, {\n  input: Buffer.from(base64Data, 'base64'),\n  timeout: 30000\n});\n\n// Get duration using ffprobe\nlet durationSeconds = 0;\ntry {\n  const result = execSync(\n    `ffprobe -v quiet -show_entries format=duration -of csv=p=0 \"${filePath}\"`,\n    { timeout: 15000 }\n  ).toString().trim();\n  durationSeconds = parseFloat(result) || 0;\n} catch(e) {\n  console.error('ffprobe error:', e.message);\n}\n\nreturn [{\n  json: {\n    ...sceneData,\n    stdout: String(durationSeconds),\n    duration_seconds: durationSeconds\n  },\n  binary: item.binary\n}];"
      }
    },
